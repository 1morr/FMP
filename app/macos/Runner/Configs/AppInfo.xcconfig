// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = fmp

// bundle identifier 與顯示名稱（APP_DISPLAY_NAME）依 flavor 不同，寫在
// Runner.xcodeproj/project.pbxproj 的每個 build configuration（app/AGENTS.md § App 身分）。

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.personal. All rights reserved.

// 本機簽章身分（ADR 0036 §決定 3 的更正）：沒有 Signing.xcconfig 就是專案層的 ad-hoc（"-"），
// CI 與發版都是。這個檔不進 repo（個人帳號的憑證與 Team ID），內容是
// `CODE_SIGN_IDENTITY = Apple Development` 與 `DEVELOPMENT_TEAM = <Team ID>`：
// keychain 以 Team ID 認重建後的 App，ad-hoc 每次建置都不同，會一直跳授權視窗。
#include? "Signing.xcconfig"
