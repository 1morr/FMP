  "fixed_sql": [
    {
      "name": "appearance_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"appearance_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"theme_mode\" TEXT NULL, \"locale\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "network_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"network_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"cache_limit_mb\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "playback_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"audio_quality\" TEXT NULL, \"audio_format_priority\" TEXT NULL, \"remember_position\" INTEGER NULL CHECK (\"remember_position\" IN (0, 1)), \"temp_play_rewind_seconds\" INTEGER NULL, \"skip_preview_clips\" INTEGER NULL CHECK (\"skip_preview_clips\" IN (0, 1)), \"output_device_id\" TEXT NULL, \"output_device_name\" TEXT NULL, \"restart_rewind_seconds\" INTEGER NULL, \"play_history_limit\" INTEGER NULL, \"auto_scroll_to_current\" INTEGER NULL CHECK (\"auto_scroll_to_current\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "installed_plugins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installed_plugins\" (\"id\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"manifest_json\" TEXT NOT NULL, \"script\" TEXT NOT NULL, \"installed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "plugin_storage",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plugin_storage\" (\"plugin_id\" TEXT NOT NULL REFERENCES installed_plugins (id) ON DELETE CASCADE, \"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"plugin_id\", \"key\"));"
        }
      ]
    }
