  "fixed_sql": [
    {
      "name": "queue_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_entries\" (\"entry_id\" INTEGER NOT NULL, \"play_order\" INTEGER NOT NULL, \"original_order\" INTEGER NULL, \"plugin_id\" TEXT NOT NULL, \"track_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"duration_ms\" INTEGER NULL, \"cover_url\" TEXT NULL, \"cover_large_url\" TEXT NULL, PRIMARY KEY (\"entry_id\"));"
        }
      ]
    },
    {
      "name": "queue_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"queue_states\" (\"id\" INTEGER NOT NULL, \"current_entry_id\" INTEGER NULL, \"next_entry_id\" INTEGER NOT NULL, \"shuffled\" INTEGER NOT NULL CHECK (\"shuffled\" IN (0, 1)), \"repeat\" TEXT NOT NULL, \"position_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "search_history_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"search_history_entries\" (\"query\" TEXT NOT NULL, \"searched_at\" INTEGER NOT NULL, PRIMARY KEY (\"query\"));"
        }
      ]
    },
    {
      "name": "chart_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chart_snapshots\" (\"plugin_id\" TEXT NOT NULL, \"fetched_at\" INTEGER NOT NULL, PRIMARY KEY (\"plugin_id\"));"
        }
      ]
    },
    {
      "name": "chart_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chart_entries\" (\"plugin_id\" TEXT NOT NULL, \"rank\" INTEGER NOT NULL, \"track_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"duration_ms\" INTEGER NULL, \"cover_url\" TEXT NULL, \"cover_large_url\" TEXT NULL, \"play_count\" INTEGER NULL, \"part_count\" INTEGER NULL, \"url\" TEXT NULL, PRIMARY KEY (\"plugin_id\", \"rank\"));"
        }
      ]
    }
