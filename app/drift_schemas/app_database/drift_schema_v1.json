        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installed_plugins\" (\"id\" TEXT NOT NULL, \"version\" TEXT NOT NULL, \"manifest_json\" TEXT NOT NULL, \"script\" TEXT NOT NULL, \"installed_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
