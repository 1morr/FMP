      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"appearance_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"theme_mode\" TEXT NULL, \"locale\" TEXT NULL, PRIMARY KEY (\"id\"));"
