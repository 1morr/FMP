{
  "search": {
    "input": { "keyword": "tone", "page": 1 },
    "expect": {
      "minItems": 2,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "tone-440",
      "purpose": "playback",
      "formats": [{ "container": "wav", "codec": "pcm_s16le" }]
    },
    "expect": { "minItems": 1, "nonEmpty": ["url", "container", "codec"] }
  },
  "live": {
    "input": { "roomId": "live-ok" },
    "expect": { "minItems": 1, "nonEmpty": ["roomId", "title", "hostName", "online"] }
  },
  "mix": {
    "input": { "seed": { "sourceId": "tone-440" } },
    "expect": { "minItems": 5, "nonEmpty": ["sourceId", "title", "uploader", "durationMs"] }
  },
  "multiPart": {
    "input": { "sourceId": "parts-220" },
    "expect": { "minItems": 3, "nonEmpty": ["cid", "title", "durationMs", "index"] }
  },
  "trackDetail": {
    "input": { "sourceId": "tone-440" },
    "expect": { "minItems": 1, "nonEmpty": ["description", "publishedAt", "album", "stats"] }
  },
  "login": {
    "input": { "cookies": { "fmp_test_session": "fake-session-0000" } },
    "expect": { "minItems": 1, "nonEmpty": ["userId", "displayName"] },
    "requiresLogin": true
  }
}
