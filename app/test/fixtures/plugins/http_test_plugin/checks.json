{
  "search": {
    "input": { "keyword": "tone", "page": 1 },
    "expect": {
      "minItems": 2,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "a1",
      "purpose": "playback",
      "formats": [{ "container": "mp4", "codec": "aac" }]
    },
    "expect": { "error": "Unavailable", "reason": "copyright" }
  }
}
