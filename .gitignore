# OS and editor noise
.DS_Store
*.swp
~$*

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code local settings only. Shared tasks/extensions can still be committed.
/.vscode/settings.json
/.vscode/launch.json

# Flutter / Dart / Pub state
/.dart_tool/
/.flutter-plugins
/.flutter-plugins-dependencies
/.pub-cache/
/.pub/
/build/
/coverage/
**/doc/api/

# pubspec.lock is tracked for this app to keep builds reproducible.

# Generated Dart sources
*.g.dart
*.freezed.dart
*.gr.dart
/lib/generated_plugin_registrant.dart

# Flutter symbolication / obfuscation output
app.*.symbols
app.*.map.json

# Android local build state and signing material
/android/.gradle/
/android/build/
/android/app/build/
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/local.properties
/android/key.properties
/android/*.jks
/android/*.keystore

# Desktop generated plugin files
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake

# Environment files and secrets
.env
.env.*
*.env
secrets.dart
secrets.json

# Logs, temporary files, and local caches
*.class
*.log
*.pyc
*.tmp
*.temp
*.local
.atom/
.build/
.buildlog/
.fvm/
.history
.svn/
.swiftpm/
/assets/cache/
/logs/
/migrate_working_dir/
/.test_coverage.dart
/test/.test_coverage.dart

# Local agent/tool state
# Track shared agent skills and the Trellis wiring (hooks, subagents,
# commands, settings.json); settings.local.json and the rest stay local.
/.claude/*
!/.claude/skills/
!/.claude/agents/
!/.claude/commands/
!/.claude/hooks/
!/.claude/settings.json
# Trellis session journals stay local: the repo is public.
/.trellis/workspace/
/.codex/
/.gstack/
/.agents/
/_bmad/
/.playwright-mcp/
/.superpowers
/.worktrees/
/devtools_home.png
/graphify-out/
/plan.md
/tmpclaude*

# Release artifacts generated outside Flutter's build directory
/release/
/fmp-v*-android-*.apk
/fmp-v*-windows.zip
/fmp-v*-windows-installer.exe

# Local audit scratch space (not version controlled)
/.scratch/
